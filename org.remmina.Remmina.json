        "*.a",
        "*.la",
        "/build-aux",
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/gnome-session",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/xsessions"
